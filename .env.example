# ANMOL Art – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon public key (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin Authentication ───────────────────────────────────────────────────────
# Admin login now uses Supabase Auth (email + password).
# No environment variable needed — create an admin user in:
#   Supabase Dashboard → Authentication → Users → Invite User
#
# The admin logs in at /admin with their email and password.
# This is fully server-side — no secrets are bundled into the JS bundle.

# ── Analytics (Optional) ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Leave empty to disable analytics
VITE_GA_ID=
