# ANMOL Art – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (find it in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon public key (safe to expose in client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Admin Panel ───────────────────────────────────────────────────────────────
# ⚠️  SECURITY WARNING: This password is bundled into the client-side JavaScript
# bundle because it uses the VITE_ prefix. This means anyone can read it from
# the browser DevTools or built files.
#
# For production, migrate to Supabase Auth (email+password login) instead.
# This environment variable approach is a temporary development shortcut only.
VITE_ADMIN_PASSWORD=your-admin-password-here

# ── Analytics (Optional) ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Leave empty to disable analytics
VITE_GA_ID=
